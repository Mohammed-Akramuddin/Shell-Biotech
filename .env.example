# Shell Biotech - Environment Configuration Example
# Copy this file to .env.local for local overrides or configure these in Vercel Project Settings.

# JWT Secret for Admin Authentication (generate a secure random 32+ char string)
ADMIN_JWT_SECRET="shell-biotech-secure-secret-key-2026-production-hyderabad"

# Optional Cloud Database (Turso / libSQL) for Vercel Serverless persistence:
# If unset, the app uses the built-in local SQLite database at data/shellbiotech.db.
# TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"
